{
  "name": "goldnead/statamic-consent",
  "description": "Cookie consent banner and two-click embed gate for Statamic 6, editable in the control panel.",
  "type": "statamic-addon",
  "license": "proprietary",
  "keywords": [
    "statamic",
    "statamic-addon",
    "consent",
    "cookie-banner",
    "gdpr",
    "dsgvo"
  ],
  "autoload": {
    "psr-4": {
      "Goldnead\\StatamicConsent\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Goldnead\\StatamicConsent\\Tests\\": "tests"
    }
  },
  "extra": {
    "statamic": {
      "slug": "statamic-consent",
      "name": "Statamic Consent",
      "description": "Cookie consent banner and two-click embed gate, editable in the control panel.",
      "url": "https://github.com/goldnead/statamic-consent",
      "developer": "Adrian Goldner",
      "developer-url": "https://gldnr.studio"
    },
    "laravel": {
      "providers": [
        "Goldnead\\StatamicConsent\\ServiceProvider"
      ]
    }
  },
  "authors": [
    {
      "name": "Adrian Goldner",
      "email": "info@adriangoldner.com"
    }
  ],
  "support": {
    "issues": "https://github.com/goldnead/statamic-consent/issues",
    "source": "https://github.com/goldnead/statamic-consent"
  },
  "require": {
    "php": "^8.2",
    "statamic/cms": "^6.0"
  },
  "require-dev": {
    "larastan/larastan": "^3.0",
    "laravel/pint": "^1.18",
    "orchestra/testbench": "^10.0",
    "phpunit/phpunit": "^11.0"
  },
  "config": {
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "sort-packages": true,
    "allow-plugins": true
  },
  "scripts": {
    "test": [
      "php -d memory_limit=-1 -d max_execution_time=0 ./vendor/bin/phpunit"
    ],
    "lint": [
      "./vendor/bin/pint --test"
    ],
    "fix": [
      "./vendor/bin/pint"
    ],
    "analyse": [
      "./vendor/bin/phpstan analyse"
    ]
  }
}
