includes:
    - vendor/larastan/larastan/extension.neon
    - phpstan-baseline.neon

parameters:
    level: 5

    paths:
        - src

    # The analytics addon is a `suggest`, not a `require`: the metrics under
    # src/Integrations/Insights extend its base class and implement its contract,
    # and it is not in vendor. Scanned from the test stand-ins — the same
    # declarations, byte for byte — so the metrics are checked against the real
    # signatures instead of being reported as unknown classes. Scanned, not
    # analysed: the files themselves are not code this package ships.
    scanFiles:
        - tests/Fakes/insights-contracts.php
        - tests/Fakes/insights-table-metric.php

    # A ratchet for new code. The baseline is empty because the findings from the
    # first run were fixed; keep it that way rather than appending to it.
